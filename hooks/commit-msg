#!/bin/sh
# no-ai-attribution: reject commits that credit an AI tool.
. "$(dirname "$0")/guard.sh"

fail=0
if ! grep -v '^#' "$1" | ag_check_message; then
  echo "no-ai-attribution: commit message credits an AI tool (lines above)." >&2
  fail=1
fi
for role in author committer; do
  ident=$(git var "GIT_$(echo $role | tr a-z A-Z)_IDENT" | sed -E 's/ [0-9]+ [-+][0-9]{4}$//')
  ag_check_ident $role "$ident" || fail=1
done

[ $fail = 1 ] && { echo "no-ai-attribution: commit rejected." >&2; exit 1; }
ag_chain commit-msg "$@"
