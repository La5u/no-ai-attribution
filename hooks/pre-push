#!/bin/sh
# no-ai-attribution: refuse to push commits, tags or notes that credit an AI tool.
# Catches anything that skipped commit-msg (--no-verify, plumbing, other machines).
. "$(dirname "$0")/guard.sh"

remote=$1
input=$(cat)
fail=0
is_zero() { case $1 in *[!0]*) return 1 ;; esac; }
# report WHERE: point at the failure printed above and fail the push
report() { echo "  ^ in $1" >&2; fail=1; }

while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] || is_zero "$lsha" && continue   # deletion
  new=1; is_zero "$rsha" || ! git cat-file -e "$rsha" 2>/dev/null || new=

  # annotated tags: check the tag message and tagger too
  if [ "$(git cat-file -t "$lsha")" = tag ]; then
    git cat-file tag "$lsha" | sed '1,/^$/d' | ag_check_message || report "tag $rref"
    tagger=$(git cat-file tag "$lsha" | sed -nE 's/^tagger (.*>).*/\1/p')
    [ -n "$tagger" ] && { ag_check_ident tagger "$tagger" || report "tag $rref"; }
  fi

  # new commits: not on the remote side of this ref, nor on any ref of this remote
  if [ -n "$new" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    commits=$(git rev-list "$lsha" --not --remotes="$remote" 2>/dev/null)
  else
    commits=$(git rev-list "$rsha..$lsha" 2>/dev/null)
  fi
  for c in $commits; do
    label="commit $(git log -1 --format='%h %s' "$c")"
    git log -1 --format=%B "$c" | ag_check_message || report "$label"
    ag_check_ident author "$(git log -1 --format='%an <%ae>' "$c")" &&
      ag_check_ident committer "$(git log -1 --format='%cn <%ce>' "$c")" || report "$label"
  done

  case "$rref" in
    # notes refs used by AI attribution tools (git-ai, Qwen Code) are refused outright
    refs/notes/ai|refs/notes/ai-*|refs/notes/*attribution*)
      echo "  refusing to push AI attribution notes: $rref" >&2; fail=1 ;;
    # other notes refs: check the text of added notes
    refs/notes/*)
      range=$lsha; [ -z "$new" ] && range="$rsha..$lsha"
      git log -p --format= "$range" | sed -n 's/^+//p' | grep -v '^++' |
        ag_check_message || report "notes $rref" ;;
  esac
done <<EOF2
$input
EOF2

[ $fail = 1 ] && { echo "no-ai-attribution: push blocked. Reword or re-author those commits first." >&2; exit 1; }
printf '%s\n' "$input" | ag_chain pre-push "$@"
